# Google App Engine generated folder
appengine-generated/
<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portfolio Tracker</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" rel="stylesheet">
  <style>
    body {
      background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 100%);
      font-family: 'Inter', system-ui, sans-serif;
    }
    .gold-gradient {
      background: linear-gradient(90deg, #facc15, #eab308, #d4af37);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .card {
      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(234, 179, 8, 0.2);
    }
  </style>
</head>
<body class="text-white min-h-screen pb-12">

  <!-- Navbar -->
  <nav class="fixed top-0 w-full bg-black/80 backdrop-blur-md z-50 border-b border-yellow-500/20">
    <div class="max-w-7xl mx-auto px-6 py-5 flex justify-between items-center">
      <h1 class="text-2xl font-bold gold-gradient">Portfolio Tracker</h1>
      <div class="flex gap-8 text-sm">
        <a href="#overview" class="hover:text-yellow-400 transition">Overview</a>
        <a href="#allocation" class="hover:text-yellow-400 transition">Alokasi</a>
        <a href="#assets" class="hover:text-yellow-400 transition">Aset</a>
      </div>
    </div>
  </nav>

  <div class="max-w-7xl mx-auto px-6 pt-24">

    <!-- Hero -->
    <div class="text-center py-16">
      <h2 class="text-5xl font-bold mb-4">Tracking Portofolio</h2>
      <p class="text-xl text-gray-400">Dana Darurat • Emas • Bitcoin</p>
      <div class="mt-8 inline-block bg-black border border-yellow-500/50 rounded-3xl px-10 py-6">
        <p class="text-sm text-gray-400">Total Nilai Portofolio</p>
        <p class="text-6xl font-bold gold-gradient mt-2" id="total-value">Rp 487.450.000</p>
      </div>
    </div>

    <!-- Overview Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16" id="overview">
      <div class="card rounded-3xl p-8 text-center">
        <p class="text-gray-400 text-sm">Dana Darurat</p>
        <p class="text-4xl font-bold mt-2">Rp 85.000.000</p>
        <p class="text-emerald-400 text-sm mt-2">+12.5% (30 hari)</p>
      </div>
      <div class="card rounded-3xl p-8 text-center">
        <p class="text-gray-400 text-sm">Emas</p>
        <p class="text-4xl font-bold mt-2">Rp 162.300.000</p>
        <p class="text-emerald-400 text-sm mt-2">+8.7% (30 hari)</p>
      </div>
      <div class="card rounded-3xl p-8 text-center">
        <p class="text-gray-400 text-sm">Bitcoin</p>
        <p class="text-4xl font-bold mt-2">Rp 240.150.000</p>
        <p class="text-emerald-400 text-sm mt-2">+34.2% (30 hari)</p>
